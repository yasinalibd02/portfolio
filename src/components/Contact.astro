---
import Icon from './Icon.astro';
import { contact, links, site } from '../data/portfolio';
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="cta reveal">
      <span class="eyebrow">Contact</span>
      <h2 id="contact-title">{contact.heading}</h2>
      <p class="lead">{contact.subtext}</p>

      <div class="actions">
        <a class="btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          WhatsApp
        </a>
        <a class="btn btn-ghost" href={`mailto:${links.email}`}>
          <Icon name="mail" />
          Email
        </a>
        <a class="btn btn-ghost" href={links.linkedin} target="_blank" rel="noopener">
          <Icon name="linkedin" />
          LinkedIn
        </a>
      </div>

      <a class="resume" href={site.resume} download>
        <Icon name="download" size={18} />
        Download Resume (PDF)
      </a>

      <p class="direct">
        <a href={`mailto:${links.email}`}>{links.email}</a>
        <span aria-hidden="true">·</span>
        <a href={`tel:${links.phone}`}>{links.phone}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: 56px 24px;
    border-radius: 28px;
    text-align: center;
    background: #0a0a0f;
    color: #ffffff;
    --text-2: #c3cad6;
    --accent-text: #f4795b;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: auto -20% -60% -20%;
    height: 120%;
    background: radial-gradient(ellipse at center, rgba(244, 121, 91, 0.35), transparent 60%);
    pointer-events: none;
  }
  .cta > * {
    position: relative;
  }
  @media (min-width: 768px) {
    .cta {
      padding: 80px 48px;
    }
  }
  :global([data-theme='dark']) .cta {
    background: var(--surface);
    border: 1px solid var(--border);
  }
  h2 {
    font-size: clamp(30px, 5vw, 50px);
    font-weight: 700;
    max-width: 720px;
    margin: 0 auto;
    text-wrap: balance;
  }
  .lead {
    max-width: 560px;
    margin: 16px auto 0;
    color: var(--text-2);
    font-size: 17px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .actions .btn-ghost {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.18);
  }
  @media (max-width: 480px) {
    .actions .btn {
      flex: 1 1 100%;
    }
  }
  .resume {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    min-height: 44px;
    padding: 8px 4px;
    color: #ffffff;
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .resume:hover {
    color: var(--accent);
  }
  .direct {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
    margin-top: 12px;
    color: var(--text-2);
    font-size: 15px;
  }
  .direct a {
    text-decoration: none;
    padding: 6px 0;
  }
  .direct a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
</style>
