---
import { experience, education } from '../data/portfolio';
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Experience</span>
      <h2 class="section-title" id="experience-title">4+ years building real products</h2>
    </div>

    <ol class="timeline">
      {
        experience.map((c) => (
          <li class="company reveal">
            <span class="dot" aria-hidden="true" />
            <h3>{c.company}</h3>
            <ol class="roles">
              {c.roles.map((r) => (
                <li class="card role">
                  <div class="role-head">
                    <h4>{r.title}</h4>
                    <span class="period">{r.period}</span>
                  </div>
                  <ul>
                    {r.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>

    <div class="education reveal">
      <h3>Education</h3>
      <ul>
        {
          education.map((e) => (
            <li class="card edu">
              <strong>{e.degree}</strong>
              <span>{e.school}</span>
              <span class="period">{e.period}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 28px;
    list-style: none;
    max-width: 820px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 15%, transparent));
  }
  .company {
    position: relative;
  }
  .company + .company {
    margin-top: 40px;
  }
  .dot {
    position: absolute;
    left: -28px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent);
  }
  .company > h3 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .roles {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .role {
    padding: 20px 22px;
  }
  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }
  h4 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
  }
  .period {
    color: var(--accent-text);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .role ul {
    margin-top: 10px;
    display: grid;
    gap: 6px;
  }
  .role li {
    position: relative;
    padding-left: 18px;
    color: var(--text-2);
    font-size: 15px;
  }
  .role li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .education {
    margin-top: 56px;
    max-width: 820px;
  }
  .education h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .education ul {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .education ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  .edu {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 20px;
  }
  .edu span:not(.period) {
    color: var(--text-2);
    font-size: 15px;
  }
</style>
