---
import Icon from './Icon.astro';
import { contact, links } from '../data/portfolio';

interface Props {
  heading?: string;
  text?: string;
}

const { heading = contact.heading, text = contact.subtext } = Astro.props;
---

<section class="section cta-section">
  <div class="container">
    <div class="cta reveal">
      <div class="ring" aria-hidden="true"></div>
      <span class="eyebrow">Let's work together</span>
      <h2>{heading}</h2>
      <p class="lead">{text}</p>
      <div class="actions">
        <a class="btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Chat on WhatsApp
        </a>
        <a class="btn btn-ghost" href="/contact">
          Send a project brief
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: 0;
  }
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 56px 24px;
    border-radius: 32px;
    text-align: center;
    background: #0a0a0f;
    color: #ffffff;
    --text-2: #c3cad6;
    --accent-text: #f4795b;
  }
  @media (min-width: 768px) {
    .cta {
      padding: 88px 48px;
    }
  }
  :global([data-theme='dark']) .cta {
    background: var(--surface);
    border: 1px solid var(--border);
  }
  /* Slowly rotating coral glow behind the content */
  .ring {
    position: absolute;
    z-index: -1;
    inset: -50%;
    background: conic-gradient(from 0deg, transparent 0 60%, rgba(244, 121, 91, 0.45) 75%, transparent 90%);
    animation: spin 10s linear infinite;
    filter: blur(40px);
  }
  .cta::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 1px;
    border-radius: 31px;
    background: radial-gradient(ellipse at 50% 120%, rgba(244, 121, 91, 0.25), transparent 60%), #0a0a0f;
  }
  :global([data-theme='dark']) .cta::after {
    background: radial-gradient(ellipse at 50% 120%, rgba(244, 121, 91, 0.25), transparent 60%), var(--surface);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  h2 {
    font-size: clamp(30px, 5vw, 52px);
    font-weight: 700;
    max-width: 760px;
    margin: 0 auto;
    text-wrap: balance;
  }
  .lead {
    max-width: 560px;
    margin: 16px auto 0;
    color: var(--text-2);
    font-size: 17px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .actions .btn-ghost {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }
  @media (max-width: 480px) {
    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
