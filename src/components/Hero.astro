---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, links, stats } from '../data/portfolio';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      {
        profile.available && (
          <p class="badge">
            <span class="pulse" aria-hidden="true" />
            Available for freelance projects
          </p>
        )
      }
      <p class="hero-name">{profile.name} · {profile.title}</p>
      <h1 id="hero-title">{profile.hero.headline}</h1>
      <p class="hero-sub">{profile.hero.subtext}</p>

      <div class="hero-ctas">
        <a class="btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Hire Me
        </a>
        <a class="btn btn-ghost" href="#projects">
          View Projects
          <Icon name="arrow" />
        </a>
      </div>

      <ul class="stats" aria-label="Highlights">
        {
          stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-photo">
      <Image
        src={profile.photo}
        alt={profile.photoAlt}
        widths={[340, 440, 680, 880]}
        sizes="(min-width: 960px) 440px, 340px"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={78}
      />
      <p class="photo-chip">
        <Icon name="pin" size={16} />
        {profile.location}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 48px 0 72px;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 30% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 30% 30%, #000 30%, transparent 75%);
  }
  .hero::after {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    right: -160px;
    top: -120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(244, 121, 91, 0.22), transparent 65%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero {
      padding: 80px 0 104px;
    }
    .hero-inner {
      grid-template-columns: 1.25fr 1fr;
      gap: 64px;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border-radius: 999px;
    background: var(--green-soft);
    color: var(--green);
    border: 1px solid color-mix(in srgb, var(--green) 30%, transparent);
    font-size: 14px;
    font-weight: 600;
  }
  .pulse {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  .hero-name {
    margin-top: 24px;
    color: var(--text-2);
    font-weight: 500;
    font-size: 15px;
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(38px, 7vw, 66px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .hero-sub {
    margin-top: 20px;
    max-width: 560px;
    color: var(--text-2);
    font-size: clamp(17px, 2vw, 19px);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  @media (max-width: 420px) {
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }

  .stats {
    display: flex;
    gap: 0;
    margin-top: 40px;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    padding: 0 24px;
    border-left: 1px solid var(--border);
  }
  .stats li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .stats strong {
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 700;
    line-height: 1.1;
  }
  .stats span {
    color: var(--text-2);
    font-size: 14px;
  }

  .hero-photo {
    position: relative;
    justify-self: center;
    width: min(100%, 340px);
  }
  @media (min-width: 960px) {
    .hero-photo {
      width: min(100%, 440px);
    }
  }
  .hero-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 55% 30%;
    border-radius: 28px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--surface-2);
  }
  .photo-chip {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    font-size: 13px;
    font-weight: 600;
  }
  .photo-chip :global(svg) {
    color: var(--accent-text);
  }
</style>
