---
import Icon from './Icon.astro';
import { links } from '../data/portfolio';
---

<a class="fab" href={links.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <Icon name="whatsapp" size={28} />
</a>

<style>
  .fab {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #0a0a0f;
    box-shadow: 0 10px 28px rgba(37, 211, 102, 0.4);
    transition: transform 0.2s ease;
  }
  .fab:hover {
    transform: scale(1.08);
  }
  @media (min-width: 768px) {
    .fab {
      right: 28px;
      bottom: 28px;
    }
  }
</style>
