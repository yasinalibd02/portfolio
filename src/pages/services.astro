---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { services, process } from '../data/portfolio';
---

<Base
  title="Services"
  description="Mobile app development, web platforms, SaaS products, AI agents, n8n automation and fintech wallet solutions by MD Yasin Ali, Full Stack Developer in Dhaka."
>
  <PageHeader
    eyebrow="Services"
    title="Everything you need to"
    highlight="launch and grow."
    lead="Apps, websites, SaaS products, AI agents and automations, built by one developer from idea to launch."
  />

  <section class="section services-section" aria-label="Services">
    <div class="container">
      <ul class="grid">
        {services.map((s, i) => <ServiceCard service={s} index={i} detailed />)}
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">How I work</span>
        <h2 class="section-title" id="process-title">A simple, clear <span class="gradient-text">process</span></h2>
      </div>
      <ol class="steps">
        {
          process.map((step, i) => (
            <li class="step reveal" style={`--i: ${i}`}>
              <span class="step-icon">
                <Icon name={step.icon} size={24} />
              </span>
              <span class="step-num">Step {i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand heading="Not sure which service you need?" text="Tell me about your idea and I'll suggest the simplest way to build it." />
</Base>

<style>
  .services-section {
    padding-top: 24px;
  }
  .grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .steps {
    position: relative;
    display: grid;
    gap: 28px;
  }
  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
    }
    /* Dashed connector line behind the step icons */
    .steps::before {
      content: '';
      position: absolute;
      top: 32px;
      left: 10%;
      right: 10%;
      border-top: 2px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    }
  }
  .step {
    position: relative;
    text-align: center;
  }
  .step-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: 0 auto;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #0a0a0f;
    box-shadow: 0 12px 30px -8px rgba(244, 121, 91, 0.6);
    transition: transform 0.4s var(--ease);
  }
  .step:hover .step-icon {
    transform: translateY(-6px) rotate(-6deg);
  }
  .step-num {
    display: block;
    margin-top: 18px;
    color: var(--accent-text);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h3 {
    margin-top: 4px;
    font-size: 20px;
    font-weight: 700;
  }
  .step p {
    margin-top: 6px;
    color: var(--text-2);
    font-size: 15px;
  }
</style>
