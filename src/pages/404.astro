---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <PageHeader eyebrow="404" title="This page" highlight="doesn't exist." lead="The link may be old or mistyped.">
    <div class="actions rise" style="--d: 3">
      <a class="btn btn-primary" href="/">Go home <Icon name="arrow" /></a>
      <a class="btn btn-ghost" href="/projects">View projects</a>
    </div>
  </PageHeader>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>
