---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { services, projects, whyMe } from '../data/portfolio';

const featured = projects.filter((p) => p.featured);
---

<Base>
  <Hero />
  <Marquee />

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head-row">
        <div class="section-head reveal">
          <span class="eyebrow">What I do</span>
          <h2 class="section-title" id="services-title">
            Apps, web, SaaS & AI. <span class="gradient-text">Built end to end.</span>
          </h2>
        </div>
        <a class="link-arrow reveal" href="/services">All services <Icon name="arrow" size={18} /></a>
      </div>
      <ul class="cards-3">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head-row">
        <div class="section-head reveal">
          <span class="eyebrow">Featured work</span>
          <h2 class="section-title" id="work-title">Products real people use</h2>
        </div>
        <a class="link-arrow reveal" href="/projects">See all projects <Icon name="arrow" size={18} /></a>
      </div>
      <ProjectGrid items={featured} />
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">Why clients hire me</span>
        <h2 class="section-title" id="why-title">One developer. <span class="gradient-text">The whole product.</span></h2>
      </div>
      <ul class="why">
        {
          whyMe.map((w, i) => (
            <li class="card spotlight reveal" style={`--i: ${i}`}>
              <span class="why-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{w.title}</h3>
              <p>{w.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .cards-3 {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .cards-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cards-3 {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .why {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .why {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .why {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .why li {
    padding: 28px 24px;
  }
  .why-num {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .why h3 {
    margin-top: 18px;
    font-size: 20px;
    font-weight: 700;
  }
  .why p {
    margin-top: 8px;
    color: var(--text-2);
    font-size: 15px;
  }
</style>
